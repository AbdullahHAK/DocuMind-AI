# Copy this file to .env and fill in ONE key. .env is git-ignored.

# Google Gemini - free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ...or Anthropic Claude (paid): https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# Everything below is optional - the defaults live in app/config.py.
# LLM_PROVIDER=gemini                      # gemini | anthropic (default: whichever key is set)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=["gemini-3.5-flash","gemini-3.8-flash"]
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_EFFORT=medium

# Leave empty to use the embedded on-disk Qdrant in backend/storage/qdrant.
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=

# Abuse protection for a public demo
# QUESTIONS_PER_IP_PER_HOUR=30
# UPLOADS_PER_IP_PER_HOUR=6
# QUESTIONS_PER_DAY_GLOBAL=600
