# Copy this file to .env and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...

# Everything below is optional - the defaults live in app/config.py.
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium

# Leave empty to use the embedded on-disk Qdrant in backend/storage/qdrant.
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=

# Abuse protection for a public demo
# QUESTIONS_PER_IP_PER_HOUR=30
# UPLOADS_PER_IP_PER_HOUR=6
# QUESTIONS_PER_DAY_GLOBAL=600
